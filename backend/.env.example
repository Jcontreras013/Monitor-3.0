# Copiar a backend/.env y completar. NUNCA subir .env al repositorio.

# Base de datos (Supabase/Neon dan una URL así; también sirve postgres://...)
DATABASE_URL=postgresql://monitor:monitor@localhost:5432/monitor

# --- API -----------------------------------------------------------------------
# Firma de las sesiones: genera uno con  openssl rand -hex 32
JWT_SECRET=
# Minutos de inactividad antes de cerrar la sesión
SESION_MINUTOS=30
# true en producción (HTTPS). En desarrollo local por http, false.
COOKIE_SEGURA=true
# "desarrollo" permite arrancar sin JWT_SECRET y usar scripts.datos_demo
ENTORNO=produccion

# --- Robot de sincronización (solo en la PC dentro de la red de MAXCOM) --------
CEPHEUS_URL=
CEPHEUS_USUARIO=
CEPHEUS_CONTRASENA=
# Cuentas a consultar, separadas por comas (se prueba la siguiente si una no trae órdenes)
CEPHEUS_USUARIOS_CONSULTA=
# Cepheus usa un certificado interno: ruta al .pem de su CA, o false como último recurso
CEPHEUS_VERIFICAR_TLS=true
SYNC_INTERVALO_MINUTOS=15
SYNC_DIAS_ATRAS=55

# --- Correo de alertas (SMTP) ---------------------------------------------------
# En la PC del robot: lo usa para avisar órdenes nuevas de clientes VIP y molex
# en cierres de soporte. En la API: solo para el botón "correo de prueba".
# 587 = STARTTLS (recomendado), 465 = SSL/TLS. En MAXCOM: smtp.us-east.atmailcloud.com
CORREO_SERVIDOR=
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CONTRASENA=
# Opcional; por defecto, CORREO_USUARIO
CORREO_REMITENTE=
# Separados por comas. Alertas de molex (y VIP si no se indica otra lista)
CORREO_DESTINATARIOS=
# Opcional: avisos de clientes VIP a otra lista
CORREO_DESTINATARIOS_VIP=

# --- Bot de Telegram (faltas desde el grupo de jefes) -----------------------------
# Token que da @BotFather y el id del grupo (número negativo, ej. -1001234567890).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
